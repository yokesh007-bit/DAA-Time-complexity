#include <stdio.h>
int main()
{
int n, i, j, k, c = 0;
scanf("%d", &n);
c = c + 2; // counts: i = n/2
for (i = n / 2; i < n; i++)
{
c = c + 2; // counts: j = 1
for (j = 1; j < n; j = 2 * j)
{
c = c + 2; // counts: k = 1
for (k = 1; k < n; k = 2 * k)
{
c = c + 2; // counts: c = c + 1
}
}
}
printf("%d\n", c);
return 0;
}
